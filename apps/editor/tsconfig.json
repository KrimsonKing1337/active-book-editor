{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@root/*": ["../../*"],
      "@book-runtime": ["../book-runtime/src"],
      "@book-runtime/*": ["../book-runtime/src/*"],
      "@build/*": ["src/build/*"],
      "@project/*": ["src/project/*"],
      "@types": ["src/@types"],
      "@types/*": ["src/@types/*"],
      "@hooks": ["src/hooks"],
      "@hooks/*": ["src/hooks/*"],
      "@styles": ["src/styles"],
      "@styles/*": ["src/styles/*"],
      "@components": ["src/components"],
      "@components/*": ["src/components/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
