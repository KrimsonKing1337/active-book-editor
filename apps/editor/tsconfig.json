{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@root/*": [
        "../../*"
      ],
      "@build/*": [
        "src/build/*"
      ],
      "@project/*": [
        "src/project/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
