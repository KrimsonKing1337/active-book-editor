{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@root/*": [
        "../../*"
      ],
      "@build/*": [
        "src/build/*"
      ],
      "@project/*": [
        "src/project/*"
      ],
      "@types": [
        "src/@types"
      ],
      "@types/*": [
        "src/@types/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@components": [
        "src/components"
      ],
      "@components/*": [
        "src/components/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
