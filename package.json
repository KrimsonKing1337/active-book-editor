{
  "name": "activebook-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @active-book/editor",
    "preview": "vite preview --outDir dist-book",
    "build:editor": "npm run build -w @active-book/editor",
    "build:book": "npm run build -w @active-book/book-builder -- \"../../../books_editor/new\"",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint:ts": "eslint \"./{apps,packages}/**/*.{ts,tsx}\" --fix --quiet",
    "lint:css": "stylelint \"{apps,packages}/**/*.scss\" --fix",
    "lint-staged": "lint-staged",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "check": "npm run typecheck && npm run lint:ts && npm run lint:css",
    "core:package": "node scripts/packageCore.mjs",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --configLoader runner --project unit",
    "test:component": "vitest run --configLoader runner --project component",
    "test:browser": "vitest run --configLoader runner --project browser",
    "test:browser:preview": "vitest run --configLoader runner --mode preview --browser.ui=false --browser.headless=false",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:ci": "vitest run --configLoader runner --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "test:runtime": "node --import tsx --test scripts/bookRuntime.browser.test.ts"
  },
  "dependencies": {
    "activeBook-core": "file:../activeBook-react-core-next/tgz/activebook-react-core-next-0.0.41.tgz",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@active-book/types": "file:../activeBook-types",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.2.7",
    "playwright": "^1.64.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.13.0",
    "vitest": "^4.1.12"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.scss": "stylelint --fix"
  }
}
