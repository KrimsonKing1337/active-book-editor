{
  "name": "active-book-editor-root",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w active-book-editor",
    "preview": "vite preview --outDir dist-book",
    "build:editor": "npm run build -w active-book-editor",
    "build:book": "npm run build -w @active-book/book-builder",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint:ts": "eslint \"./{apps,packages}/**/*.{ts,tsx}\" --fix --quiet",
    "lint:css": "stylelint \"{apps,packages}/**/*.scss\" --fix",
    "lint-staged": "lint-staged",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint:ts:check && npm run lint:css:check",
    "core:package": "node scripts/packageCore.mjs",
    "test": "vitest run --configLoader runner",
    "test:all": "node scripts/testAll.mjs",
    "test:unit": "vitest run --configLoader runner --project unit",
    "test:component": "vitest run --configLoader runner --project component",
    "test:browser": "vitest run --configLoader runner --project browser",
    "bench:content": "vitest run --configLoader runner --project browser ContentValidation.performance --reporter=default --reporter=json --outputFile.json=test-results/content-validation-benchmark.json",
    "test:browser:preview": "vitest run --configLoader runner --mode preview --browser.ui=false --browser.headless=false",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:ci": "vitest run --configLoader runner --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
    "test:runtime": "node --import tsx --test tests/book-runtime/bookRuntime.browser.test.ts",
    "test:tgz:workflow": "node --import tsx --test tests/book-runtime/tgzWorkflow.browser.test.ts",
    "lint:ts:check": "eslint \"./{apps,packages}/**/*.{ts,tsx}\"",
    "lint:css:check": "stylelint \"{apps,packages}/**/*.scss\"",
    "test:scripts": "node --test tests/package-core/packageCore.test.mjs",
    "test:media:runtime": "node --import tsx --test tests/media/mediaRuntime.browser.test.ts",
    "test:media:workflow": "node --import tsx --test tests/media/mediaWorkflow.browser.test.ts",
    "core:build": "npm --prefix ../active-book-core run build"
  },
  "dependencies": {
    "@active-book/core": "file:../active-book-core"
  },
  "devDependencies": {
    "@active-book/common": "file:../active-book-common",
    "@active-book/types": "file:../active-book-types",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tiptap/core": "^3.33.0",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.4.0",
    "playwright": "1.65.0",
    "sass": "^1.108.1",
    "stylelint": "16.26.1",
    "vite": "^8.3.6",
    "vitest": "4.1.12"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.scss": "stylelint --fix"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5"
  },
  "engines": {
    "node": "^24.15.0",
    "npm": "^11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KrimsonKing1337/active-book-editor.git"
  },
  "license": "AGPL-3.0-only"
}
