{
  "name": "activebook-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @active-book/editor",
    "preview": "vite preview --outDir dist-book",
    "build:editor": "npm run build -w @active-book/editor",
    "build:book": "npm run build -w @active-book/book-builder",
    "lint": "eslint \"./{apps,packages}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"./{apps,packages}/**/*.{ts,tsx}\" --fix"
  },
  "dependencies": {
    "activeBook-core": "file:../activeBook-react-core-next/tgz/activebook-react-core-next-0.0.8.tgz",
    "sass": "^1.96.0"
  },
  "devDependencies": {
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^26.5.1",
    "vite-plugin-svgr": "^5.2.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jiti": "^2.6.1"
  }
}
