{
  "name": "activebook-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @active-book/editor",
    "preview": "vite preview --outDir dist-book",
    "build:editor": "npm run build -w @active-book/editor",
    "build:book": "npm run build -w @active-book/book-builder",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint \"./{apps,packages}/**/*.{ts,tsx}\" --quiet && stylelint \"{apps,packages}/**/*.scss\"",
    "lint:ts": "eslint \"./{apps,packages}/**/*.{ts,tsx}\" --fix --quiet",
    "lint:css": "stylelint \"{apps,packages}/**/*.scss\" --fix",
    "lint-staged": "lint-staged",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "check": "npm run typecheck && npm run lint",
    "core:package": "node scripts/packageCore.mjs"
  },
  "dependencies": {
    "activeBook-core": "file:../activeBook-react-core-next/tgz/activebook-react-core-next-0.0.22.tgz",
    "react-router-dom": "^7.10.1"
  },
  "devDependencies": {
    "@active-book/types": "file:../activeBook-types",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.13.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.scss": "stylelint --fix"
  }
}
